{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SFX cue in audio/cues.json format (audio/cues.py GEN + EMIT; post ops gain|widen|pan|st2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "at", "gen", "args"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "at": { "type": "integer", "minimum": 0, "description": "story frame (30 fps)" },
    "offset": { "type": "number", "minimum": -5, "maximum": 5, "description": "seconds relative to `at`" },
    "gen": { "type": "string", "enum": ["whoosh", "boom", "crack", "wood_crack", "oof", "whoa", "squeak", "crackles", "breeze", "water", "birds", "rumble", "roar", "hum", "glock", "steps", "clicks", "notes"] },
    "args": { "type": "object" },
    "span": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2, "description": "[fromFrame, toFrame] -> duration" },
    "start": { "type": "integer", "minimum": 0, "description": "emitters only: frame the emitter starts at" },
    "extra": { "type": "number", "minimum": 0, "maximum": 10 },
    "post": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "items": [ { "type": "string", "enum": ["gain", "widen", "pan", "st2"] }, { "type": "number" } ]
      }
    },
    "sync": { "type": "boolean" },
    "word": { "type": "string" },
    "segmentId": { "type": "string", "pattern": "^N[0-9]{2}$" },
    "shotId": { "type": "integer", "minimum": 1 },
    "intent": { "type": "string", "description": "why this sound exists (meaningful SFX only)" },
    "note": { "type": "string" }
  }
}
