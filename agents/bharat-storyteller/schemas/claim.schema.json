{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Research claim (SPEC §3, §12 C/I)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "claim", "category", "confidence", "sources", "qualification", "usableInScript"],
  "properties": {
    "id": { "type": "string", "pattern": "^C[0-9]{2,3}$" },
    "claim": { "type": "string", "minLength": 5 },
    "category": { "type": "string", "enum": ["fact", "disputed", "legend", "mythology"] },
    "confidence": { "type": "string", "enum": ["high", "medium", "low", "unverified"] },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "type", "read"],
        "properties": {
          "title": { "type": "string", "minLength": 3 },
          "url": { "type": "string", "pattern": "^https?://[^\\s]+$" },
          "type": { "type": "string", "enum": ["government", "asi", "institutional", "academic", "peer-reviewed", "primary-document", "news", "expert", "encyclopedia", "museum", "other"] },
          "read": { "type": "string", "enum": ["page", "snippet"], "description": "page = the page was fetched and read; snippet = only a search-result snippet was seen" },
          "accessed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "quote": { "type": "string", "description": "short supporting excerpt, verbatim from the source" }
        }
      }
    },
    "qualification": { "type": "string", "description": "how the claim must be phrased if used (e.g. 'according to tradition', 'estimates range ...'); empty string if none needed" },
    "usableInScript": { "type": "boolean" },
    "debunked": { "type": "boolean", "description": "true for popular claims that were checked and found false (listed so they are NOT used)" },
    "notes": { "type": "string" }
  }
}
