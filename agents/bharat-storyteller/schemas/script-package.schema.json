{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BHARAT STORYTELLER script package (script.json) — SPEC §13",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fps", "width", "height", "story", "claims", "hooks", "narration", "world", "shots", "events", "audio", "quality", "futureDevelopment", "publishing"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "fps": { "const": 30 },
    "width": { "const": 1080 },
    "height": { "const": 1920 },
    "story": { "$ref": "story.schema.json" },
    "claims": { "type": "array", "minItems": 1, "items": { "$ref": "claim.schema.json" } },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["options", "recommended", "reason"],
      "properties": {
        "options": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "technique", "text", "score"],
            "properties": {
              "id": { "type": "string", "pattern": "^H[1-5]$" },
              "technique": { "type": "string", "enum": ["revelation", "question", "dramatic-situation", "surprising-fact", "contradiction", "mystery", "emotional-statement", "unusual-comparison", "visual-curiosity"] },
              "text": { "type": "string", "minLength": 3 },
              "score": { "type": "integer", "minimum": 1, "maximum": 10 },
              "claimIds": { "type": "array", "items": { "type": "string", "pattern": "^C[0-9]{2,3}$" } },
              "critique": { "type": "string" }
            }
          }
        },
        "recommended": { "type": "string", "pattern": "^H[1-5]$" },
        "reason": { "type": "string", "minLength": 10 }
      }
    },
    "narration": { "$ref": "narration.schema.json" },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenes", "cast", "subjects"],
      "properties": {
        "scenes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "basedOn", "description", "components"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
              "kind": { "type": "string", "enum": ["reuse", "adapt", "new"], "description": "reuse = existing set as is; adapt = existing components re-dressed; new = new world.ts code" },
              "basedOn": { "type": "string", "enum": ["taiga", "straw", "tree", "office", "globe", "none"] },
              "description": { "type": "string", "minLength": 10 },
              "components": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "cast": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "description"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
              "kind": { "type": "string", "enum": ["human", "animal"] },
              "description": { "type": "string" },
              "build": { "type": "string", "enum": ["adult", "stout", "kid"] },
              "hat": { "type": "string", "enum": ["none", "hood", "cap", "hair", "shako", "shako_tall", "tophat", "bonnet"] },
              "outfit": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "jacket": { "$ref": "#/definitions/hex" }, "pants": { "$ref": "#/definitions/hex" }, "boots": { "$ref": "#/definitions/hex" },
                  "cap": { "$ref": "#/definitions/hex" }, "hair": { "$ref": "#/definitions/hex" }, "sash": { "$ref": "#/definitions/hex" },
                  "skin": { "$ref": "#/definitions/hex" }, "moustache": { "$ref": "#/definitions/hex" }, "dress": { "$ref": "#/definitions/hex" },
                  "buttons": { "$ref": "#/definitions/hex" }, "belt": { "$ref": "#/definitions/hex" }
                }
              },
              "animal": { "type": "string", "enum": ["reindeer", "new"] },
              "respectNote": { "type": "string" }
            }
          }
        },
        "subjects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "heightM"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
              "castId": { "type": "string" },
              "place": { "type": "string" },
              "heightM": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    },
    "shots": { "type": "array", "minItems": 3, "items": { "$ref": "shot.schema.json" } },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flashAt", "flashes", "hits", "kicks"],
      "properties": {
        "flashAt": { "type": "integer", "minimum": 0, "description": "4-frame white flash (engine requires one inside the timeline)" },
        "flashes": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } },
        "hits": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "kicks": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cues", "music"],
      "properties": {
        "cues": { "type": "array", "items": { "$ref": "audio-cue.schema.json" } },
        "music": {
          "type": "object",
          "additionalProperties": false,
          "required": ["beats"],
          "properties": {
            "beats": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "shots", "chord", "level"],
                "properties": {
                  "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                  "shots": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 2, "maxItems": 2 },
                  "chord": { "type": "string", "enum": ["Dm", "F", "Gm", "A", "Bb", "C"] },
                  "level": { "type": "number", "minimum": 0.3, "maximum": 1.3 },
                  "mood": { "type": "string" }
                }
              }
            }
          }
        },
        "master": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "fade_in": { "type": "number", "minimum": 0 }, "fade_out": { "type": "number", "minimum": 0 } }
        }
      }
    },
    "quality": { "$ref": "quality-report.schema.json" },
    "futureDevelopment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "feature", "need", "suggestion"],
        "properties": {
          "id": { "type": "string", "pattern": "^F[0-9]{2}$" },
          "feature": { "type": "string" },
          "need": { "type": "string" },
          "shotIds": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
          "suggestion": { "type": "string" },
          "workaround": { "type": "string" }
        }
      }
    },
    "publishing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titles", "thumbnails", "description", "hashtags", "pinnedComment"],
      "properties": {
        "titles": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "string", "minLength": 5, "maxLength": 100 } },
        "thumbnails": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["concept", "text"],
            "properties": { "concept": { "type": "string", "minLength": 10 }, "text": { "type": "string", "maxLength": 40 } }
          }
        },
        "description": { "type": "string", "minLength": 20 },
        "hashtags": { "type": "array", "minItems": 3, "maxItems": 15, "items": { "type": "string", "pattern": "^#[^\\s#]+$" } },
        "pinnedComment": { "type": "string", "minLength": 10 }
      }
    }
  },
  "definitions": {
    "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
  }
}
