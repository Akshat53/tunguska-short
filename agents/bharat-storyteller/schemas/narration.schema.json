{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Narration + voice direction (SPEC §6, §9, §12 D/E)",
  "type": "object",
  "additionalProperties": false,
  "required": ["language", "voice", "wps", "totalWords", "estimatedSpeechSec", "segments"],
  "properties": {
    "language": { "type": "string", "enum": ["hinglish", "hindi", "english"] },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "id", "rate"],
      "properties": {
        "engine": { "type": "string", "enum": ["edge-tts", "elevenlabs", "human", "other"] },
        "id": { "type": "string", "minLength": 2 },
        "rate": { "type": "string", "pattern": "^[+-][0-9]{1,2}%$" }
      }
    },
    "wps": { "type": "number", "minimum": 1.5, "maximum": 3.4, "description": "spoken words per second used for timing (incl. natural sentence gaps)" },
    "totalWords": { "type": "integer", "minimum": 40, "maximum": 260 },
    "estimatedSpeechSec": { "type": "number", "minimum": 10, "maximum": 90 },
    "segments": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/definitions/segment" }
    }
  },
  "definitions": {
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "beat", "startSec", "endSec", "startFrame", "endFrame", "text", "voiceEmotion", "speed", "emphasis", "pauseAfterSec", "intensity", "claimIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^N[0-9]{2}$" },
        "beat": { "type": "string", "enum": ["hook", "context", "escalation", "revelation", "explanation", "payoff", "ending"] },
        "startSec": { "type": "number", "minimum": 0 },
        "endSec": { "type": "number", "exclusiveMinimum": 0 },
        "startFrame": { "type": "integer", "minimum": 0 },
        "endFrame": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1, "pattern": "^[^\\[\\]*_]*$", "description": "clean TTS text: no [pause] markers, no *emphasis* marks" },
        "marked": { "type": "string", "description": "the same text with [pause x] and *emphasis* markers (section D)" },
        "voiceEmotion": { "type": "string", "enum": ["calm", "curious", "warm", "tense", "awed", "grave", "playful", "wry", "urgent", "reflective", "triumphant", "somber"] },
        "speed": { "type": "number", "minimum": 0.8, "maximum": 1.25 },
        "emphasis": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "pauseAfterSec": { "type": "number", "minimum": 0, "maximum": 1.5 },
        "intensity": { "type": "integer", "minimum": 1, "maximum": 10 },
        "musicMood": { "type": "string" },
        "ambient": { "type": "string" },
        "sfx": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } },
        "claimIds": { "type": "array", "items": { "type": "string", "pattern": "^C[0-9]{2,3}$" } },
        "deliveryNote": { "type": "string" }
      }
    }
  }
}
