    },
    {
      "i": 10,
      "start": 16.55,
      "words": 7,
      "intensity": 4.0,
      "entities": [],
      "text": "The fits lasted hours, then came back."
    },
    {
      "i": 11,
      "start": 19.61,
      "words": 9,
      "intensity": 3.0,
      "entities": [],
      "text": "So officials closed the school and sent everyone home."
    },
    {
      "i": 12,
      "start": 22.8,
      "words": 2,
      "intensity": 5.5,
      "entities": [],
      "text": "Big mistake."
    },
    {
      "i": 13,
      "start": 23.96,
      "words": 7,
      "intensity": 3.0,
      "entities": [],
      "text": "The girls carried it to their villages."
    },
    {
      "i": 14,
      "start": 26.14,
      "words": 1,
      "intensity": 6.5,
      "entities": [],
      "text": "Poison?"
    },
    {
      "i": 15,
      "start": 26.94,
      "words": 1,
      "intensity": 6.5,
      "entities": [],
      "text": "Infection?"
    },
    {
      "i": 16,
      "start": 27.89,
      "words": 3,
      "intensity": 5.5,
      "entities": [],
      "text": "Doctors found neither."
    },
    {
      "i": 17,
      "start": 29.34,
      "words": 4,
      "intensity": 5.5,
      "entities": [],
      "text": "So what was it?"
    },
    {
      "i": 18,
      "start": 30.42,
      "words": 4,
      "intensity": 4.5,
      "entities": [],
      "text": "Tell me your theory."
    },
    {
      "i": 19,
      "start": 31.8,
      "words": 6,
      "intensity": 4.5,
      "entities": [],
      "text": "The leading explanation: mass psychogenic illness."
    },
    {
      "i": 20,
      "start": 35.29,
      "words": 15,
      "intensity": 3.0,
      "entities": [],
      "text": "The country had won independence just weeks earlier, and these students lived under intense pressure."
    },
    {
      "i": 21,
      "start": 40.78,
      "words": 6,
      "intensity": 4.5,
      "entities": [],
