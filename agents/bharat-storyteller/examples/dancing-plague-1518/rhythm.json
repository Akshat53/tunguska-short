      "entities": [
        "Strasbourg"
      ],
      "text": "A crowd is dancing through Strasbourg, and no one can stop."
    },
    {
      "i": 2,
      "start": 4.56,
      "words": 2,
      "intensity": 5.5,
      "entities": [],
      "text": "July, fifteen-eighteen."
    },
    {
      "i": 3,
      "start": 7.19,
      "words": 5,
      "intensity": 5.5,
      "entities": [],
      "text": "What makes a city dance?"
    },
    {
      "i": 4,
      "start": 9.17,
      "words": 11,
      "intensity": 3.0,
      "entities": [],
      "text": "One woman started it, dancing alone in the street for days."
    },
    {
      "i": 5,
      "start": 13.03,
      "words": 6,
      "intensity": 4.5,
      "entities": [],
      "text": "Within a week, dozens joined her."
    },
    {
      "i": 6,
      "start": 15.33,
      "words": 3,
      "intensity": 6.5,
      "entities": [],
      "text": "The doctors' cure?"
    },
    {
      "i": 7,
      "start": 16.93,
      "words": 2,
      "intensity": 5.5,
      "entities": [],
      "text": "More dancing."
    },
    {
      "i": 8,
      "start": 18.21,
      "words": 8,
      "intensity": 3.0,
      "entities": [],
      "text": "The council built a stage and hired musicians."
    },
    {
      "i": 9,
      "start": 21.15,
      "words": 4,
      "intensity": 5.5,
      "entities": [],
      "text": "The crowd only grew."
    },
    {
      "i": 10,
      "start": 23.15,
      "words": 5,
      "intensity": 5.5,
      "entities": [],
      "text": "Did anyone dance to death?"
    },
    {
      "i": 11,
      "start": 25.27,
      "words": 8,
      "intensity": 3.0,
      "entities": [],
      "text": "Later chronicles claim up to fifteen a day."
    },
    {
      "i": 12,
      "start": 28.23,
      "words": 6,
      "intensity": 4.5,
      "entities": [],
      "text": "The city's own records mention none."
    },
    {
      "i": 13,
      "start": 30.81,
      "words": 3,
      "intensity": 6.5,
      "entities": [],
      "text": "So why dance?"
    },
    {
      "i": 14,
      "start": 32.47,
      "words": 8,
      "intensity": 3.0,
      "entities": [],
      "text": "Strasbourg had suffered years of famine and disease."
    },
    {
      "i": 15,
      "start": 35.75,
      "words": 11,
      "intensity": 4.0,
      "entities": [
        "Saint Vitus",
        "Vitus",
        "Saint"
      ],
      "text": "And people feared Saint Vitus, who could curse sinners to dance."
    },
    {
      "i": 16,
      "start": 40.07,
      "words": 6,
      "intensity": 5.0,
      "entities": [
        "Psychogenic"
      ],
      "text": "The leading theory: mass psychogenic illness."
    },
    {
      "i": 17,
      "start": 43.72,
      "words": 5,
      "intensity": 4.5,
      "entities": [],
      "text": "Fear, spreading body to body."
    },
    {
      "i": 18,
      "start": 45.92,
      "words": 5,
      "intensity": 5.5,
      "entities": [],
      "text": "Would you have joined in?"
    },
    {
      "i": 19,
      "start": 47.68,
      "words": 1,
      "intensity": 5.5,
      "entities": [],
      "text": "Careful."
    },
    {
      "i": 20,
      "start": 48.4,
      "words": 10,
      "intensity": 4.0,
      "entities": [],
      "text": "It only takes one dancer to start a whole crowd."
