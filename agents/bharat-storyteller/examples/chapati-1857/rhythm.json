      "text": "रातों-रात, एक गाँव से दूसरे गाँव पहुँचती रोटियाँ।"
    },
    {
      "i": 2,
      "start": 3.1,
      "words": 5,
      "intensity": 5.5,
      "entities": [],
      "text": "इन्हें भेज कौन रहा है?"
    },
    {
      "i": 3,
      "start": 5.05,
      "words": 8,
      "intensity": 3.5,
      "entities": [
        "सौ"
      ],
      "text": "अठारह सौ सत्तावन, अंग्रेज़ यही पूछ रहे थे।"
    },
    {
      "i": 4,
      "start": 8.14,
      "words": 9,
      "intensity": 5.0,
      "entities": [
        "मथुरा",
        "चार"
      ],
      "text": "मथुरा के मजिस्ट्रेट को मेज़ पर मिलीं, चार रोटियाँ।"
    },
    {
      "i": 5,
      "start": 11.59,
      "words": 13,
      "intensity": 3.0,
      "entities": [],
      "text": "किसी अजनबी ने चौकीदार को रोटी दी, कि ऐसी चार बनाओ, आगे पहुँचाओ।"
    },
    {
      "i": 6,
      "start": 16.33,
      "words": 6,
      "intensity": 4.5,
      "entities": [],
      "text": "चार से सोलह, सोलह से चौंसठ।"
    },
    {
      "i": 7,
      "start": 18.63,
      "words": 12,
      "intensity": 3.5,
      "entities": [
        "दो"
      ],
      "text": "एक अफ़सर का अंदाज़ा था, रात में सौ से दो सौ मील।"
    },
    {
      "i": 8,
      "start": 23.13,
      "words": 7,
      "intensity": 4.0,
      "entities": [],
      "text": "रोटियाँ तोड़कर देखी गईं, अंदर कोई ख़त?"
    },
    {
      "i": 9,
      "start": 25.88,
      "words": 3,
      "intensity": 6.5,
      "entities": [],
      "text": "कुछ नहीं मिला।"
    },
    {
      "i": 10,
      "start": 26.93,
      "words": 11,
      "intensity": 4.5,
      "entities": [
        "दिल्ली"
      ],
      "text": "दिल्ली के बादशाह का हकीम भी बोला, मक़सद कोई नहीं जानता।"
    },
    {
      "i": 11,
      "start": 31.07,
      "words": 7,
      "intensity": 3.0,
      "entities": [],
      "text": "कुछ अफ़सरों को लगा, बग़ावत का इशारा।"
    },
    {
      "i": 12,
      "start": 33.52,
      "words": 5,
      "intensity": 4.5,
      "entities": [],
      "text": "दूसरे बोले, हैजे का टोटका।"
    },
    {
      "i": 13,
      "start": 35.57,
      "words": 17,
      "intensity": 3.5,
      "entities": [
        "मेरठ"
      ],
      "text": "और फिर मई में, मेरठ के सिपाहियों ने बग़ावत कर दी, जो उत्तर भारत में फैल गई।"
    },
    {
      "i": 14,
      "start": 41.91,
      "words": 4,
      "intensity": 5.5,
      "entities": [],
      "text": "क्या रोटियाँ इशारा थीं?"
    },
    {
      "i": 15,
      "start": 43.61,
      "words": 15,
      "intensity": 4.0,
      "entities": [
        "इंदौर",
        "किम वैगनर"
      ],
      "text": "इतिहासकार किम वैगनर मानते हैं, ये शायद इंदौर से चला, हैजे को भगाने के लिए।"
    },
    {
      "i": 16,
      "start": 48.85,
      "words": 9,
      "intensity": 4.0,
      "entities": [],
      "text": "पर बग़ावत से रिश्ता, आज तक साबित नहीं हुआ।"
    },
    {
      "i": 17,
      "start": 52.4,
      "words": 7,
      "intensity": 4.0,
      "entities": [],
      "text": "आपको क्या लगता है, इशारा या दुआ?"
    },
    {
      "i": 18,
      "start": 55.15,
      "words": 4,
      "intensity": 5.5,
      "entities": [],
      "text": "जवाब आज भी नहीं।"
    },
    {
      "i": 19,
      "start": 56.55,
      "words": 9,
      "intensity": 3.0,
      "entities": [],
      "text": "बचा है बस ये नज़ारा, रातों-रात गाँव-गाँव पहुँचती रोटियाँ।"
    }
  ]
