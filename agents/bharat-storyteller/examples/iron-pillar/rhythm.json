        "सौ"
      ],
      "text": "सोलह सौ साल का लोहा, और आज तक जंग नहीं?"
    },
    {
      "i": 2,
      "start": 3.8,
      "words": 5,
      "intensity": 5.5,
      "entities": [],
      "text": "पर सच और अजीब है।"
    },
    {
      "i": 3,
      "start": 5.79,
      "words": 13,
      "intensity": 3.5,
      "entities": [
        "क़ुतुब मीनार"
      ],
      "text": "क़ुतुब मीनार के आँगन का ये खंभा, लोहारों ने गरम टुकड़े पीटकर बनाया।"
    },
    {
      "i": 4,
      "start": 10.34,
      "words": 14,
      "intensity": 4.0,
      "entities": [],
      "text": "किसी ने इस पर तोप का गोला दागा, गड्ढा पड़ा, पर ये टूटा नहीं।"
    },
    {
      "i": 5,
      "start": 15.49,
      "words": 6,
      "intensity": 5.5,
      "entities": [],
      "text": "तो क्या ये जादुई लोहा है?"
    },
    {
      "i": 6,
      "start": 17.88,
      "words": 1,
      "intensity": 6.5,
      "entities": [],
      "text": "नहीं।"
    },
    {
      "i": 7,
      "start": 18.23,
      "words": 8,
      "intensity": 3.0,
      "entities": [],
      "text": " जंग इसे भी लगी, शुरू में तेज़ी से।"
    },
    {
      "i": 8,
      "start": 21.28,
      "words": 11,
      "intensity": 3.0,
      "entities": [],
      "text": "फिर कुछ ऐसा हुआ, जिसने जंग को ही ढाल बना दिया।"
    },
    {
      "i": 9,
      "start": 25.13,
      "words": 13,
      "intensity": 4.0,
      "entities": [],
      "text": "इस लोहे में फ़ॉस्फ़रस ज़्यादा था, जिससे सतह पर पतली, कसी परत बनी।"
    },
    {
      "i": 10,
      "start": 29.92,
      "words": 12,
      "intensity": 4.0,
      "entities": [],
      "text": "पुराने लोहार भट्टी में चूना नहीं डालते थे, तो फ़ॉस्फ़रस रह गया।"
    },
    {
      "i": 11,
      "start": 34.37,
      "words": 1,
      "intensity": 6.5,
      "entities": [],
      "text": "सबूत?"
    },
    {
      "i": 12,
      "start": 34.92,
      "words": 13,
      "intensity": 3.0,
      "entities": [],
      "text": "लोग किस्मत के लिए इसे बाँहों में भरते थे, वो हिस्सा चमकता था।"
    },
    {
      "i": 13,
      "start": 39.46,
      "words": 14,
      "intensity": 3.0,
      "entities": [],
      "text": "फिर जाली लगी, और करीब साल भर में वो चमक भी भूरी पड़ गई।"
    },
    {
      "i": 14,
      "start": 44.61,
      "words": 6,
      "intensity": 5.5,
      "entities": [],
      "text": "ये खंभा जंग से बचा नहीं।"
    },
    {
      "i": 15,
      "start": 47.01,
      "words": 4,
      "intensity": 4.5,
      "entities": [],
      "text": "जंग ने इसे बचाया।"
    }
  ]
